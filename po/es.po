#: lib/prefs/behaviorPage.js:45
msgid "Behavior"
msgstr "Comportamiento"

#: lib/prefs/behaviorPage.js:47
msgid "Playback"
msgstr "Reproducción"

#: lib/prefs/behaviorPage.js:48
msgid "Pause other players"
msgstr "Pausar otros reproductores"

#: lib/prefs/behaviorPage.js:49
msgid "When a player starts playing, pause the rest"
msgstr "Cuando un reproductor empieza a sonar, pausa los demás"

#: lib/prefs/behaviorPage.js:50
msgid "Click the artwork to show the player"
msgstr "Clic en la carátula para mostrar el reproductor"

#: lib/prefs/behaviorPage.js:51
msgid "Brings the player’s window to the front"
msgstr "Trae al frente la ventana del reproductor"

#: lib/prefs/behaviorPage.js:54
msgid "GNOME integration"
msgstr "Integración con GNOME"

#: lib/prefs/behaviorPage.js:55
msgid "Hide the built-in media player"
msgstr "Ocultar el reproductor integrado"

#: lib/prefs/behaviorPage.js:56
msgid ""
"Removes GNOME’s own player from the notification list. Relies on GNOME "
"internals and may stop working after a GNOME update."
msgstr ""
"Quita el reproductor propio de GNOME de la lista de notificaciones. Depende "
"de partes internas de GNOME y puede dejar de funcionar tras una "
"actualización."

#: lib/prefs/behaviorPage.js:59 lib/ui/mediaCard.js:203
msgid "Lyrics"
msgstr "Letras"

#: lib/prefs/behaviorPage.js:60
msgid "Look up lyrics online"
msgstr "Buscar letras en internet"

#: lib/prefs/behaviorPage.js:61
msgid ""
"Sends the artist, title, album and duration of the current track to "
"lrclib.net and lyrics.ovh. Lyrics provided by the player are always used "
"first."
msgstr ""
"Envía el artista, el título, el álbum y la duración de la pista actual a "
"lrclib.net y lyrics.ovh. Siempre se usan primero las letras que da el "
"reproductor."

#: lib/prefs/behaviorPage.js:64
msgid "Album art cache"
msgstr "Caché de carátulas"

#: lib/prefs/behaviorPage.js:64
msgid ""
"Artwork downloaded from the internet is kept in ~/.cache/encore-now-playing."
msgstr ""
"Las carátulas descargadas de internet se guardan en ~/.cache/encore-now-"
"playing."

#: lib/prefs/behaviorPage.js:65
msgid "Maximum size"
msgstr "Tamaño máximo"

#: lib/prefs/behaviorPage.js:66
msgid "In MB"
msgstr "En MB"

#: lib/prefs/behaviorPage.js:68
msgid "Clear cache"
msgstr "Vaciar caché"

